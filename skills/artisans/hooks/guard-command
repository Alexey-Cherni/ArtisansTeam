#!/usr/bin/env bash
# Artisans — PreToolUse guard for Claude Code and GitHub Copilot (VS Code and CLI).
# Adapted from the example team's hooks/guard-command; the deny rules are the same.
#
# While an Artisans run is active (the marker {trackingDir}/active exists) it
# denies shell commands no role should ever run, with a one-line reason:
#
#   kills by name or pattern     pkill, killall, kill $(pgrep ...), ... | xargs kill, kill -1, kill 0
#   recursive rm of a wide tree  a glob, /, ~, $HOME, ., .., a path above the project, or one level under / or ~
#   force push                   --force, -f, --force-with-lease, a +ref
#   git clean -f                 any flag cluster containing f, or --force
#   discarding uncommitted work  git reset --hard, git checkout -- <path>, git checkout ., git restore <path>
#
# Without the marker it prints nothing, so your own sessions are never affected.
# A command whose whole text equals a Command cell of {trackingDir}/knowledge/TOOLCHAIN.md
# (written by /artisans-knowledge) is exempt: the knowledge file is the permission.
# Output: Claude Code format when CLAUDE_PROJECT_DIR is set, otherwise the
# Copilot format (top-level for the CLI plus hookSpecificOutput for VS Code).
# Exit 0 with no output = allowed. Every failure path is silent and exits 0.

set -uo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

# trackingDir from the installed config (Claude Code or Copilot layout), default .artisans
TRACKING=".artisans"
for cfg in "$PROJECT_DIR/.claude/skills/artisans/config.json" "$PROJECT_DIR/.github/skills/artisans/config.json"; do
  [ -f "$cfg" ] || continue
  t="$(sed -n 's/^[[:space:]]*"trackingDir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null | head -1)"
  [ -n "$t" ] && TRACKING="$t"
  break
done
MARKER="$PROJECT_DIR/$TRACKING/active"
TOOLCHAIN="$PROJECT_DIR/$TRACKING/knowledge/TOOLCHAIN.md"

payload="$(cat 2>/dev/null || true)"

[ -f "$MARKER" ] || exit 0

# tool_input.command, still JSON-escaped, then unescaped: \\ first through a
# placeholder, so \\n stays a backslash and an n.
raw="$(printf '%s' "$payload" | sed -n -E 's/.*"command"[[:space:]]*:[[:space:]]*"((\\.|[^"\\])*)".*/\1/p' 2>/dev/null | head -1)"
[ -n "$raw" ] || exit 0
cmd="${raw//\\\\/$'\001'}"
cmd="${cmd//\\\"/\"}"
cmd="${cmd//\\n/$'\n'}"
cmd="${cmd//\\t/$'\t'}"
cmd="${cmd//\\r/$'\r'}"
cmd="${cmd//\\\//\/}"
cmd="${cmd//$'\001'/\\}"

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Building blocks. A simple command ends at ; & | or a line break.
S='(^|[;&|(`[:space:]])'        # start of a word that names a command
E='([[:space:];&|)`]|$)'        # end of a word
A='[^;&|]*'                     # the rest of one simple command
Q="[\"']?"                      # an optional quote around a target
RMF='(-[[:alpha:]]*[rR][[:alpha:]]*|--recursive)'
RMT="(${Q}[^[:space:];&|]*[*?][^[:space:];&|]*|${Q}(/|~|\\\$HOME|\\\$\\{HOME\\}|\\.|\\.\\.)/?${Q}|${Q}\\.\\./[^[:space:];&|]*|${Q}(/|~/|\\\$HOME/|\\\$\\{HOME\\}/)[^/[:space:];&|]+/?${Q})"

# One pattern per line, in the spec's order: name, regex, reason.
KSIG='(-[sn][[:space:]]+[[:alnum:]]+|--signal(=|[[:space:]]+)[[:alnum:]]+|-[[:alnum:]]+|--)'   # a signal option, or -- before the target
KILL_RE="${S}(pkill|killall)${E}|${S}kill[[:space:]]${A}(\\\$\\(|\`)[[:space:]]*pgrep|${S}xargs([[:space:]]${A})?[[:space:]]kill${E}|${S}kill([[:space:]]+${KSIG})*[[:space:]]+(-1|0)[[:space:]]*([;&|)\`]|\$)"
KILL_WHY="Artisans guard: killing processes by name or pattern (pkill, killall, kill \$(pgrep ...), xargs kill, kill -1, kill 0) can reach the user's own processes. Kill the exact process ID your own command started, or ask the user to stop the process."

RM_RE="${S}rm([[:space:]]${A})?[[:space:]]${RMF}[[:space:]](${A}[[:space:]])?${RMT}${E}|${S}rm([[:space:]]${A})?[[:space:]]${RMT}[[:space:]](${A}[[:space:]])?${RMF}${E}"
RM_WHY="Artisans guard: a recursive rm whose target is a glob, /, ~, \$HOME, ., .., a path above the project, or a path one level under / or the home directory can delete the wrong tree. Delete an exact relative path inside the project instead, or ask the user to run the command."

PUSH_RE="${S}git([[:space:]]${A})?[[:space:]]push([[:space:]]${A})?[[:space:]](--force(-with-lease)?(=[^[:space:];&|]*)?|-[[:alpha:]]*f[[:alpha:]]*|\\+[^[:space:];&|]+)${E}"
PUSH_WHY="Artisans guard: a force push rewrites a shared branch. Push without --force, or ask the user to force-push."

CLEAN_RE="${S}git([[:space:]]${A})?[[:space:]]clean([[:space:]]${A})?[[:space:]](-[[:alpha:]]*f[[:alpha:]]*|--force)${E}"
CLEAN_WHY="Artisans guard: git clean -f deletes untracked files, which may be other work in the checkout. Delete the exact files your own commands created instead, or ask the user to clean."

DISCARD_RE="${S}git([[:space:]]${A})?[[:space:]](reset([[:space:]]${A})?[[:space:]]--hard|checkout([[:space:]]${A})?[[:space:]]--[[:space:]]+[^[:space:];&|]|checkout([[:space:]]${A})?[[:space:]]+${Q}\\.{1,2}(/[^[:space:];&|]*)?${Q}${E}|restore${E}${A})"
DISCARD_UNLESS='restore[[:space:]]([^;&|]*[[:space:]])?(--staged|-S)([[:space:]]|$)'
WORKTREE_RE="${S}git([[:space:]]${A})?[[:space:]]restore([[:space:]]${A})?[[:space:]](--worktree|-[[:alpha:]]*W[[:alpha:]]*)${E}"
DISCARD_WHY="Artisans guard: git reset --hard, git checkout -- <path>, git checkout . and git restore <path> discard uncommitted work. Leave the working tree as it is: change files with edits, set work aside with git stash, or ask the user to discard it."

reason=""
# deny_if REASON REGEX [UNLESS]: a hit whose matched text also matches UNLESS does not count.
deny_if() {
  [ -z "$reason" ] || return 0
  local hits
  hits="$(printf '%s\n' "$cmd" | grep -oE -- "$2" 2>/dev/null)" || return 0
  if [ -n "${3:-}" ]; then
    hits="$(printf '%s\n' "$hits" | grep -vE -- "$3" 2>/dev/null)" || return 0
  fi
  [ -z "$hits" ] || reason="$1"
}
deny_if "$KILL_WHY" "$KILL_RE"
deny_if "$RM_WHY" "$RM_RE"
deny_if "$PUSH_WHY" "$PUSH_RE"
deny_if "$CLEAN_WHY" "$CLEAN_RE"
deny_if "$DISCARD_WHY" "$DISCARD_RE" "$DISCARD_UNLESS"
deny_if "$DISCARD_WHY" "$WORKTREE_RE"   # --staged with --worktree or -W still discards

[ -n "$reason" ] || exit 0

# The exemption: the whole command equals the second cell of a table row in
# TOOLCHAIN.md, trimmed, with one pair of backticks around the whole cell
# removed. An escaped pipe \| inside the cell reads as |.
if [ -f "$TOOLCHAIN" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in '|'*) ;; *) continue ;; esac
    rest="${line#|}"
    rest="${rest//\\|/$'\001'}"
    case "$rest" in *'|'*) ;; *) continue ;; esac
    cell="${rest#*|}"
    cell="${cell%%|*}"
    cell="${cell//$'\001'/|}"
    cell="${cell#"${cell%%[![:space:]]*}"}"
    cell="${cell%"${cell##*[![:space:]]}"}"
    if [ "${#cell}" -ge 2 ] && [ "${cell:0:1}" = '`' ] && [ "${cell: -1}" = '`' ]; then
      cell="${cell:1:${#cell}-2}"
    fi
    [ "$cell" = "$cmd" ] && exit 0
  done < "$TOOLCHAIN" 2>/dev/null
fi

why="$(escape_for_json "$reason")"
if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$why"
else
  printf '{"permissionDecision":"deny","permissionDecisionReason":"%s","hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$why" "$why"
fi
exit 0
